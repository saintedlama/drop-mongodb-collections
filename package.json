{
  "name": "drop-mongodb-collections",
  "version": "3.0.0",
  "description": "Drops all (non system) mongodb collections",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "prebuild": "npm run clean",
    "clean": "rimraf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:ci": "vitest run --coverage"
  },
  "author": "Christoph Walcher <christoph.walcher@gmail.com>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saintedlama/drop-mongodb-collections.git"
  },
  "keywords": [
    "mongodb",
    "collections",
    "test",
    "testing"
  ],
  "bugs": {
    "url": "https://github.com/saintedlama/drop-mongodb-collections/issues"
  },
  "homepage": "https://github.com/saintedlama/drop-mongodb-collections#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/debug": "^4.1.13",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "mongodb": "^7.6.0"
  }
